---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import credits from '@/data/photos.json';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.jpg', { eager: true });
---

<PageLayout
  title="Photo credits"
  heading="Photo credits."
  description="The photographs on dottra.co, who took them, and the licences they are used under."
  eyebrow="Credits"
  crumbName="Photo credits"
  summary="The photographs on this site were taken in Zambia by the photographers below and shared on Wikimedia Commons under free licences. We use them unchanged apart from resizing."
>
  <ul class="credits-list">
    {credits.map((c) => {
      const src = images[`/src/assets/photos/${c.file}`]?.default;
      return (
        <li>
          {src && <Image src={src} alt={c.alt} width={280} format="webp" quality={60} />}
          <p>
            <strong>{c.title}</strong><br />
            {c.alt}<br />
            By <a href={c.sourceUrl} rel="noopener">{c.author}</a>, licensed under
            <a href={c.licenseUrl} rel="noopener license">{c.license}</a>, via Wikimedia Commons.
          </p>
        </li>
      );
    })}
  </ul>
</PageLayout>
