---
// A licensed photograph with its attribution underneath. Images are optimised
// by Astro at build time (responsive WebP, explicit dimensions, lazy loading).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import credits from '@/data/photos.json';

interface Props {
  name: string;
  className?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  aspect?: number;
}

const {
  name,
  className = '',
  widths = [480, 800, 1200],
  sizes = '(max-width: 860px) 100vw, 560px',
  eager = false,
} = Astro.props;

const credit = credits.find((item) => item.key === name);
if (!credit) {
  throw new Error(`Unknown photo "${name}". Add it to scripts/fetch-photos.ts.`);
}

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.jpg', { eager: true });
const source = images[`/src/assets/photos/${credit.file}`]?.default;
if (!source) {
  throw new Error(`Photo file missing: src/assets/photos/${credit.file}. Run bun scripts/fetch-photos.ts.`);
}
---

<figure class={`photo ${className}`.trim()}>
  <Image
    src={source}
    alt={credit.alt}
    widths={widths.filter((w) => w <= source.width)}
    sizes={sizes}
    format="webp"
    quality={68}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
  <figcaption>
    Photo: <a href={credit.sourceUrl} rel="noopener">{credit.author}</a>,
    <a href={credit.licenseUrl} rel="noopener license">{credit.license}</a>, via Wikimedia Commons.
  </figcaption>
</figure>
