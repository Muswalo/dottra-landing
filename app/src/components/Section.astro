---
// One row of the two-column content layout already used across the old site:
// heading on the left, prose on the right.
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<section class="content-section" id={id}>
  <div class="content-heading"><h2>{title}</h2></div>
  <div class="prose">
    <slot />
  </div>
</section>
