---
// Single source of truth for <head>. Every page passes title, description
// and its own breadcrumbs/schema; canonical, OG, Twitter and the JSON-LD
// @graph (Organization + WebSite + BreadcrumbList + page node) are derived
// here so they can never drift between pages.
import { site } from '@/data/site';

export type Crumb = { name: string; href: string };

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedAt?: string;
  modifiedAt?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  ogImage = '/og/home.png',
  ogType = 'website',
  publishedAt,
  modifiedAt,
  noindex = false,
  breadcrumbs = [],
  schema = [],
} = Astro.props;

const base = site.url;
const canonical = new URL(path, base).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const imageUrl = new URL(ogImage, base).href;
// Search engines cut descriptions at ~160 characters; trim on a word boundary.
const metaDescription =
  description.length <= 160 ? description : `${description.slice(0, 157).replace(/\s+\S*$/, '')}...`;

const orgId = `${base}/#organization`;
const websiteId = `${base}/#website`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: site.name,
    legalName: site.legalName,
    url: `${base}/`,
    logo: `${base}/apple-icon-180x180.png`,
    email: site.email.company,
    telephone: site.phone,
    identifier: { '@type': 'PropertyValue', propertyID: 'PACRA', value: site.pacra },
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      postalCode: site.address.postalCode,
      addressCountry: site.address.country,
    },
    sameAs: [site.googlePlayUrl],
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${base}/`,
    name: site.name,
    inLanguage: 'en-ZM',
    publisher: { '@id': orgId },
  },
];

if (breadcrumbs.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.href, base).href,
    })),
  });
}

for (const node of schema) {
  graph.push(node);
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c',
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content="#ffffff" />
<meta name="format-detection" content="telephone=no" />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />
<link rel="manifest" href="/manifest.json" />
<link rel="alternate" type="application/rss+xml" title="Dottra blog" href="/feed.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_ZM" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
{ogType === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
{ogType === 'article' && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={jsonLd} />
